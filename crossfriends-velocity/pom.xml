<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.cordfriends</groupId>
    <artifactId>CordFriends-Velocity</artifactId>
    <version>1.1.4</version>
    <packaging>jar</packaging>

    <name>CordFriends-Velocity</name>
    <description>Plugin Velocity : amis, messages prives et courrier hors-ligne inter-serveur</description>

    <parent>
        <groupId>com.cordfriends</groupId>
        <artifactId>cordfriends-parent</artifactId>
        <version>1.1.4</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- velocity-api n'est pas sur Maven Central, il faut le depot PaperMC -->
    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!--
             API officielle de Velocity. La version "-SNAPSHOT" est la version de
             developpement courante publiee par PaperMC (c'est la version utilisee
             par tous les plugins Velocity a jour, malgre son nom) ; verifiez sur
             https://repo.papermc.io/#browse/browse:maven-public:com%2Fvelocitypowered%2Fvelocity-api
             si une version plus recente est disponible au moment de la compilation.
        -->
        <dependency>
            <groupId>com.velocitypowered</groupId>
            <artifactId>velocity-api</artifactId>
            <version>3.4.0-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>CordFriends-Velocity-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <!-- Velocity utilise des annotations traitees a la compilation (@Plugin) -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.velocitypowered</groupId>
                            <artifactId>velocity-api</artifactId>
                            <version>3.4.0-SNAPSHOT</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
